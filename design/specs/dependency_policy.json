{
  "id": "distribution-license-policy",
  "scope": [
    "bundled_code",
    "linked_product_dependency",
    "runtime_loaded_product_dependency",
    "plugin",
    "helper",
    "generated_code"
  ],
  "acceptable_code_categories": [
    "permissive",
    "public-domain"
  ],
  "excluded_code_categories": [
    "gpl-family",
    "commercial-paid"
  ],
  "term_classification_rule": "Classify each term, including exceptions, from full upstream license evidence, not its identifier alone; unknown classifications fail closed.",
  "license_expression_rule": "At least one complete OR branch; every AND term in the selected branch must have an acceptable, non-excluded classification.",
  "evidence_fields": [
    "license_expression",
    "selected_terms",
    "term_classifications",
    "source",
    "content_digest",
    "notices",
    "distribution_scope"
  ],
  "resource_review": {
    "fonts": "embedding_and_redistribution_terms",
    "documentation": "redistribution_terms",
    "model_assets": "user_managed_separate_acquisition"
  },
  "platform_runtime_review": {
    "classification": "platform_provided_runtime",
    "evidence": [
      "provider",
      "linkage",
      "redistribution",
      "applicable_terms",
      "approval"
    ]
  },
  "external_service_review": {
    "classification": "platform_service",
    "evidence": [
      "protocol",
      "client_code_terms",
      "data_flow",
      "permission"
    ]
  },
  "model_distribution": "separate_user_acquisition",
  "decision_basis": "file_and_dependency_closure",
  "notice_delivery": "bundled_and_user_accessible"
}
